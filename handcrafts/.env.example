# Public origin of the Azure Functions app, without a trailing slash.
NEXT_PUBLIC_STORE_API_URL=http://localhost:7071
NEXT_PUBLIC_SITE_URL=
# Browser origin allowed by the API; set to the exact deployed storefront origin.
STORE_ORIGIN=http://localhost:3000

# PostgreSQL. Configure TLS according to the managed database provider.
DATABASE_URL=postgresql://store_user:replace-with-local-password@localhost:5432/handcraft_store
# Local-only default; use verify-full (or provider-approved TLS) for managed databases.
PGSSLMODE=disable
PG_POOL_MAX=8

# Generate a random secret with at least 32 bytes. Server-side only.
SESSION_SECRET=replace-with-at-least-32-random-bytes

# Checkout calculations; zero/blank shipping and tax are not a business policy.
SHIPPING_FLAT_RATE_PAISE=0
FREE_SHIPPING_THRESHOLD_PAISE=
TAX_RATE_BASIS_POINTS=0

# Razorpay remains disabled unless all three values are valid and verified.
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# Azure Blob Storage: use a dedicated public-read container for approved product images only.
AZURE_STORAGE_CONNECTION_STRING=
AZURE_STORAGE_CONTAINER=product-media

# Azure Functions local runtime.
AzureWebJobsStorage=UseDevelopmentStorage=true
FUNCTIONS_WORKER_RUNTIME=node
